.screen { min-height:100vh; padding:30rpx 28rpx calc(44rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#f2f1ef; color:#1d2024; }
.topbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:30rpx; }
.overline { display:block; color:#a26b59; font-size:18rpx; font-weight:700; letter-spacing:4rpx; }
.brand { display:block; margin-top:5rpx; color:#1d2024; font-size:32rpx; font-weight:700; }
.top-action { padding:12rpx 20rpx; border:2rpx solid #dedbd7; border-radius:999rpx; color:#666a6e; background:#faf9f7; font-size:22rpx; }
.launch-panel { position:relative; overflow:hidden; display:flex; flex-direction:column; min-height:400rpx; padding:34rpx 30rpx 28rpx; box-sizing:border-box; border-radius:28rpx; background:#20252b; box-shadow:0 14rpx 30rpx rgba(28,32,38,.16); }
.launch-panel:after { position:absolute; right:-90rpx; top:-100rpx; width:300rpx; height:300rpx; border:1rpx solid rgba(235,180,154,.28); border-radius:50%; content:''; }
.launch-copy { position:relative; z-index:1; }
.launch-kicker { display:block; color:#e9a88d; font-size:21rpx; font-weight:600; letter-spacing:2rpx; }
.launch-title { display:block; max-width:500rpx; margin-top:18rpx; color:#fff; font-size:42rpx; line-height:1.3; font-weight:700; }
.accent { color:#f3b498; }
.launch-desc { display:block; margin-top:12rpx; color:#aeb3b8; font-size:23rpx; }
.launch-orbit { position:absolute; right:42rpx; top:44rpx; z-index:1; display:flex; align-items:center; justify-content:center; width:106rpx; height:106rpx; border:1rpx solid rgba(243,180,152,.42); border-radius:50%; color:#f3b498; }
.orbit-mark { font-size:30rpx; line-height:1; }
.launch-meta { position:relative; margin-top:auto; padding-top:28rpx; display:flex; align-items:center; color:#d9dde0; font-size:23rpx; }
.meta-dot { margin:0 10rpx; color:#e9a88d; }
.launch-button { position:relative; width:100%; margin-top:18rpx; height:72rpx; border-radius:16rpx; color:#20252b; background:#f3b498; font-size:27rpx; font-weight:700; }
.launch-button-content { display:flex; align-items:center; justify-content:center; height:72rpx; }
.button-arrow { margin-left:14rpx; font-size:32rpx; line-height:1; }
.section-heading { display:flex; align-items:baseline; justify-content:space-between; margin:38rpx 2rpx 18rpx; }
.template-heading { margin-top:30rpx; }
.heading-title { color:#24282d; font-size:30rpx; font-weight:700; }
.heading-note { color:#999b9d; font-size:21rpx; }

/* 方案 B：8 大人群 2x4 网格 — emoji 主视觉 + 淡色渐变背景 */
.cohort-grid { display:grid; grid-template-columns:repeat(4, 1fr); gap:14rpx; }
.cohort-card { position:relative; display:flex; flex-direction:column; align-items:center; min-height:210rpx; padding:22rpx 10rpx 18rpx; box-sizing:border-box; border:2rpx solid transparent; border-radius:20rpx; box-shadow:0 4rpx 14rpx rgba(45,43,40,.06); transition:all .18s ease; }
.cohort-card:active { opacity:.82; transform:scale(.96); }
.cohort-selected { border-color:#c8795f; box-shadow:0 8rpx 22rpx rgba(174,103,76,.22); transform:translateY(-2rpx); }
/* 8 人群淡色渐变背景 */
.cohort-bg-0 { background:linear-gradient(160deg,#faf5ff,#f3e8ff); }
.cohort-bg-1 { background:linear-gradient(160deg,#fdf2f8,#fce7f3); }
.cohort-bg-2 { background:linear-gradient(160deg,#eff6ff,#dbeafe); }
.cohort-bg-3 { background:linear-gradient(160deg,#fff7ed,#ffedd5); }
.cohort-bg-4 { background:linear-gradient(160deg,#f0fdfa,#ccfbf1); }
.cohort-bg-5 { background:linear-gradient(160deg,#fffbeb,#fef3c7); }
.cohort-bg-6 { background:linear-gradient(160deg,#fffbeb,#fde68a); }
.cohort-bg-7 { background:linear-gradient(160deg,#f8fafc,#e2e8f0); }
.cohort-emoji { font-size:44rpx; line-height:1; margin-bottom:10rpx; filter:drop-shadow(0 2rpx 4rpx rgba(0,0,0,.08)); }
.cohort-emoji-custom { font-size:40rpx; color:#c8795f; }
.cohort-name { display:block; color:#1d2024; font-size:25rpx; font-weight:700; text-align:center; letter-spacing:.5rpx; }
.cohort-detail { display:block; margin-top:5rpx; height:48rpx; color:#7a7d80; font-size:18rpx; text-align:center; line-height:1.35; overflow:hidden; }
.cohort-budget { display:inline-block; margin-top:auto; padding:4rpx 12rpx; border-radius:10rpx; background:rgba(255,255,255,.7); color:#5a5d60; font-size:17rpx; font-weight:650; backdrop-filter:blur(4rpx); }
.cohort-selected .cohort-budget { background:#c8795f; color:#fff; }
.cohort-check { position:absolute; right:10rpx; top:10rpx; display:flex; align-items:center; justify-content:center; width:32rpx; height:32rpx; border-radius:50%; color:#fff; background:#c8795f; font-size:18rpx; font-weight:700; box-shadow:0 2rpx 6rpx rgba(174,103,76,.3); }
.cohort-custom { border:2rpx dashed #c8b8ad; background:repeating-linear-gradient(45deg,#faf9f7,#faf9f7 10rpx,#f5f3f0 10rpx,#f5f3f0 20rpx); }

/* 模板横向滚动 */
.template-scroller { width:calc(100% + 28rpx); margin-left:-28rpx; }
.template-track { display:flex; gap:16rpx; padding:0 28rpx 14rpx; }
.template-card { position:relative; flex:0 0 300rpx; min-height:138rpx; padding:22rpx; box-sizing:border-box; border:2rpx solid #e6e2de; border-radius:18rpx; background:#fbfaf8; }
.template-title { display:block; overflow:hidden; color:#292d32; font-size:26rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.template-detail,.template-time { display:block; margin-top:10rpx; color:#929396; font-size:20rpx; }
.template-time { margin-top:5rpx; color:#b0aaa5; font-size:18rpx; }
.template-arrow { position:absolute; right:18rpx; bottom:18rpx; color:#aaa6a2; font-size:34rpx; }
.tool-row { display:flex; gap:14rpx; margin-top:28rpx; }
.tool-item { display:flex; align-items:center; min-width:0; flex:1; padding:20rpx 16rpx; box-sizing:border-box; border-top:1rpx solid #dad6d1; border-bottom:1rpx solid #dad6d1; }
.tool-icon { display:flex; align-items:center; justify-content:center; width:50rpx; height:50rpx; flex-shrink:0; margin-right:12rpx; border-radius:15rpx; color:#b66750; background:#f5e4dc; font-size:27rpx; }
.tool-icon-muted { color:#85817d; background:#e7e4e0; }
.tool-title { display:block; color:#373a3d; font-size:23rpx; font-weight:650; }
.tool-desc { display:block; margin-top:5rpx; color:#999896; font-size:19rpx; }
.tool-arrow { margin-left:auto; color:#aaa6a2; font-size:34rpx; }
.loading-mask { position:fixed; inset:0; z-index:100; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(242,241,239,.94); }
.loading-spinner { width:50rpx; height:50rpx; border:4rpx solid #eadbd4; border-top-color:#b66750; border-radius:50%; animation:spin .8s linear infinite; }
.loading-text { margin-top:16rpx; color:#85817d; font-size:23rpx; }
@keyframes spin { to { transform:rotate(360deg); } }

/* 会话恢复模态框 */
.recovery-modal-mask { position:fixed; inset:0; z-index:200; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.5); padding:40rpx; box-sizing:border-box; }
.recovery-modal { width:100%; max-width:560rpx; padding:48rpx 36rpx 32rpx; box-sizing:border-box; border-radius:28rpx; background:#fff; display:flex; flex-direction:column; align-items:center; }
.recovery-modal-icon { width:88rpx; height:88rpx; border-radius:50%; background:#fef3e8; display:flex; align-items:center; justify-content:center; font-size:40rpx; margin-bottom:20rpx; }
.recovery-modal-title { font-size:32rpx; font-weight:700; color:#1d2024; margin-bottom:12rpx; }
.recovery-modal-desc { font-size:24rpx; color:#85817d; text-align:center; line-height:1.6; margin-bottom:32rpx; }
.recovery-modal-actions { display:flex; flex-direction:column; gap:16rpx; width:100%; margin-bottom:20rpx; }
.recovery-btn { width:100%; height:80rpx; border-radius:16rpx; font-size:28rpx; font-weight:600; display:flex; align-items:center; justify-content:center; border:none; }
.recovery-btn::after { border:none; }
.recovery-btn-primary { background:#c8795f; color:#fff; }
.recovery-btn-primary[disabled] { opacity:.6; }
.recovery-btn-secondary { background:#f5f3f0; color:#666a6e; }
.recovery-btn-secondary[disabled] { opacity:.6; }
.recovery-modal-cancel { font-size:26rpx; color:#a2a09c; padding:12rpx 24rpx; }

/* 团队任务卡片 */
.assignment-section { margin-top:8rpx; }
.assignment-list { display:flex; flex-direction:column; gap:14rpx; }
.assignment-card { display:flex; align-items:center; padding:24rpx 22rpx; box-sizing:border-box; border-radius:20rpx; background:#fff; box-shadow:0 4rpx 16rpx rgba(45,43,40,.07); border-left:6rpx solid #c8795f; }
.assignment-card:active { opacity:.85; transform:scale(.98); }
.assignment-done { border-left-color:#a0a0a0; opacity:.75; }
.assignment-main { flex:1; min-width:0; }
.assignment-title-row { display:flex; align-items:center; gap:12rpx; }
.assignment-title { overflow:hidden; color:#1d2024; font-size:27rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.assignment-badge { flex-shrink:0; padding:4rpx 12rpx; border-radius:8rpx; font-size:18rpx; font-weight:600; }
.assignment-badge-active { color:#b66750; background:#f5e4dc; }
.assignment-badge-done { color:#888; background:#eee; }
.assignment-meta { display:flex; align-items:center; margin-top:10rpx; color:#8a8d90; font-size:21rpx; }
.assignment-meta-item { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.assignment-meta-dot { margin:0 10rpx; color:#ccc; }
.assignment-action { flex-shrink:0; margin-left:16rpx; }
.assignment-action-text { color:#b66750; font-size:25rpx; font-weight:700; }
