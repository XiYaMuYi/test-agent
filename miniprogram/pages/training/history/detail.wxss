.container {
  min-height: 100vh;
  background: #f4f5f8;
  display: flex;
  flex-direction: column;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 26rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.summary-title { font-size: 32rpx; font-weight: 700; color: #222; display: block; }
.summary-sub { font-size: 24rpx; color: #aaa; margin-top: 6rpx; display: block; }
.summary-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.score-chip {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  background: linear-gradient(135deg, #ff6b9d, #ff8e53);
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
}
.score-chip.pending { background: #f0f1f5; }
.score-num { color: #fff; font-size: 36rpx; font-weight: 800; }
.score-grade { color: #fff; font-size: 24rpx; }
.score-chip.pending .score-grade { color: #999; }

/* T32.3：整体客户情绪标签（摘要区） */
.mood-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.mood-label { opacity: 0.75; }
.mood-value { font-weight: 600; }
.mood-positive {
  background: #e8f8ee;
  color: #1a9d47;
  border: 2rpx solid #b6e8c5;
}
.mood-neutral {
  background: #f2f3f5;
  color: #6b7280;
  border: 2rpx solid #d9dbe0;
}
.mood-negative {
  background: #fdecec;
  color: #d93a3a;
  border: 2rpx solid #f5c2c2;
}

.replay {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg-row { display: flex; margin-bottom: 24rpx; }
.msg-row-user { justify-content: flex-end; }
.bubble-left { display: flex; align-items: flex-start; }
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb199, #ff6b9d);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.bubble {
  max-width: 480rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
}
.bubble-customer {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.bubble-me {
  background: linear-gradient(135deg, #ff6b9d, #ff8e53);
  color: #fff;
  border-top-right-radius: 6rpx;
}
.replay-end { text-align: center; color: #c0c0c8; font-size: 22rpx; padding: 30rpx 0; }

.state-mask {
  padding-top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe3ee;
  border-top-color: #ff6b9d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.state-text { margin-top: 20rpx; color: #999; font-size: 26rpx; }
.btn-line {
  margin-top: 28rpx;
  color: #ff4f93;
  border: 2rpx solid #ffd0e2;
  background: #fff0f5;
  padding: 12rpx 48rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ============================================================================
 * T32.3：学员消息列（气泡 + 逐轮情绪 + 教练点评卡片纵向排列）
 * 复用 conversation 页的视觉风格（蓝色调教练卡片）。
 * ========================================================================= */
.user-msg-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 520rpx;
}

/* T32.3：逐轮客户情绪标签（贴在学员气泡下方） */
.turn-mood-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
}
.turn-mood-label { opacity: 0.8; }
.turn-mood-value { font-weight: 600; }

/* T32.3：教练点评卡片（蓝色调，可折叠） */
.coach-card {
  margin-top: 10rpx;
  background: #eef4ff;
  border: 2rpx solid #c9d9f7;
  border-radius: 16rpx;
  width: 100%;
  overflow: hidden;
}
.coach-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
}
.coach-card-title {
  font-size: 22rpx;
  color: #3b63d8;
  font-weight: 600;
}
.coach-card-arrow {
  font-size: 20rpx;
  color: #3b63d8;
}
.coach-card-body {
  padding: 0 20rpx 18rpx;
}

/* 评分进度条 */
.coach-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.coach-rating-label {
  font-size: 22rpx;
  color: #5a6aa0;
  flex-shrink: 0;
}
.coach-rating-bar {
  flex: 1;
  height: 14rpx;
  background: #d6dffa;
  border-radius: 999rpx;
  overflow: hidden;
}
.coach-rating-fill {
  height: 100%;
  background: linear-gradient(90deg, #6a8cff, #3b63d8);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.coach-rating-value {
  font-size: 22rpx;
  color: #3b63d8;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 56rpx;
  text-align: right;
}

/* 点评文字 */
.coach-feedback-text {
  margin-bottom: 12rpx;
}
.coach-feedback-label {
  display: block;
  font-size: 22rpx;
  color: #5a6aa0;
  margin-bottom: 6rpx;
}
.coach-feedback-content {
  font-size: 24rpx;
  color: #2d3560;
  line-height: 1.55;
}

/* 改进建议列表 */
.coach-improvements-label {
  display: block;
  font-size: 22rpx;
  color: #5a6aa0;
  margin-bottom: 6rpx;
}
.coach-improvement-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 4rpx;
}
.coach-improvement-dot {
  color: #3b63d8;
  font-size: 24rpx;
  line-height: 1.55;
  flex-shrink: 0;
}
.coach-improvement-text {
  font-size: 24rpx;
  color: #2d3560;
  line-height: 1.55;
}
