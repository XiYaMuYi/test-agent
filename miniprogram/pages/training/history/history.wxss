.container {
  min-height: 100vh;
  background: #f6f6f9;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.list { display: flex; flex-direction: column; gap: 20rpx; }

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}
.item:active { transform: scale(0.99); }

.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item-title { font-size: 30rpx; font-weight: 700; color: #222; flex: 1; }
.badge {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.badge-done { background: #eafaf1; color: #18a058; }
.badge-live { background: #fff3e8; color: #ff8e53; }

.item-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.item-tag {
  font-size: 24rpx;
  color: #ff4f93;
  background: #fff0f5;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.item-score { display: flex; align-items: baseline; gap: 8rpx; }
.score-label { font-size: 22rpx; color: #aaa; }
.score-num { font-size: 38rpx; font-weight: 800; color: #ff6b9d; }

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f5f8;
}
.item-time { font-size: 22rpx; color: #bbb; }
.item-go { font-size: 24rpx; color: #999; }

.load-more {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 28rpx 0;
}

.state-mask {
  padding-top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 88rpx; }
.empty-text { margin-top: 24rpx; font-size: 30rpx; color: #555; font-weight: 600; }
.empty-hint { margin-top: 12rpx; font-size: 24rpx; color: #aaa; padding: 0 60rpx; text-align: center; }
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe3ee;
  border-top-color: #ff6b9d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.state-text { margin-top: 20rpx; color: #999; font-size: 26rpx; }
.btn-primary {
  margin-top: 36rpx;
  background: linear-gradient(135deg, #ff6b9d, #ff8e53);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 56rpx;
  line-height: 80rpx;
  height: 80rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
