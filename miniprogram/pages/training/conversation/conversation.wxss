.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f4f5f8;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  z-index: 2;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.turn-text {
  font-size: 26rpx;
  color: #888;
}

/* T28.3：客户情绪状态标签 */
.mood-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.mood-label {
  opacity: 0.75;
}
.mood-value {
  font-weight: 600;
}
.mood-assessing {
  margin-left: 6rpx;
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.6;
}
.mood-positive {
  background: #e8f8ee;
  color: #1a9d47;
  border: 2rpx solid #b6e8c5;
}
.mood-neutral {
  background: #f2f3f5;
  color: #6b7280;
  border: 2rpx solid #d9dbe0;
}
.mood-negative {
  background: #fdecec;
  color: #d93a3a;
  border: 2rpx solid #f5c2c2;
}
.end-btn {
  font-size: 24rpx;
  color: #ff4f93;
  background: #fff0f5;
  border: 2rpx solid #ffd0e2;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
}
.end-btn-disabled { opacity: 0.6; }

/* 等学员先开口（openingMode=wait_learner）空对话引导卡 */
.learner-first-hint {
  margin: 48rpx 32rpx;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #fff5f9, #ffffff);
  border: 2rpx dashed #ffb3d1;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  text-align: center;
}
.lfh-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff4f93;
  background: #ffe3ee;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
}
.lfh-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.chat-area {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 12rpx;
  box-sizing: border-box;
}
.chat-bottom { height: 8rpx; }

.empty-error-card {
  width: calc(100% - 48rpx);
  margin: 150rpx auto 0;
  padding: 42rpx 34rpx 34rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #eceef2;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(28, 35, 50, 0.07);
}
.empty-error-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #d94e76;
  background: #fff0f4;
  font-size: 34rpx;
  font-weight: 700;
}
.empty-error-title { margin-top: 20rpx; color: #292d35; font-size: 30rpx; font-weight: 700; }
.empty-error-text { margin-top: 12rpx; color: #8f949e; font-size: 24rpx; line-height: 1.55; text-align: center; }
.empty-error-actions { width: 100%; margin-top: 30rpx; display: flex; gap: 16rpx; }
.empty-btn { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 25rpx; font-weight: 600; }
.empty-btn.secondary { color: #626771; background: #f2f3f5; }
.empty-btn.primary { color: #fff; background: #e6537d; }

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}
.msg-row-user {
  justify-content: flex-end;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
}
.avatar-customer {
  background: linear-gradient(135deg, #ffb199, #ff6b9d);
  margin-right: 16rpx;
}
.avatar-me {
  background: linear-gradient(135deg, #8e9efc, #6a7ff0);
  margin-left: 16rpx;
}
.msg-bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.msg-ai {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.msg-user {
  background: linear-gradient(135deg, #ff6b9d, #ff8e53);
  color: #fff;
  border-top-right-radius: 6rpx;
}
.typing .dots {
  color: #bbb;
  letter-spacing: 6rpx;
}

.input-area {
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.msg-input {
  flex: 1;
  min-width: 0;
  min-height: 44rpx;
  max-height: 176rpx;
  box-sizing: border-box;
  background: #f3f4f7;
  border-radius: 22rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
  overflow-y: auto;
}
.send-btn {
  width: 120rpx;
  text-align: center;
  line-height: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #e2e3e8;
  color: #fff;
  font-size: 28rpx;
}
.send-btn.active {
  background: linear-gradient(135deg, #ff6b9d, #ff8e53);
  font-weight: 600;
}

.error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 12rpx;
  padding: 16rpx 24rpx;
  background: #fff5f5;
  border: 2rpx solid #ffd9d9;
  border-radius: 14rpx;
}
.error-text { color: #e05b5b; font-size: 24rpx; }
.error-retry { color: #ff4f93; font-size: 24rpx; font-weight: 600; }

.state-mask {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe3ee;
  border-top-color: #ff6b9d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.state-text { margin-top: 20rpx; color: #999; font-size: 26rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* T28.3：学员消息列（气泡 + 教练点评卡片纵向排列） */
.user-msg-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 520rpx;
}

/* T28.3：教练点评卡片（蓝色调，可折叠） */
.coach-card {
  margin-top: 12rpx;
  background: #eef4ff;
  border: 2rpx solid #c9d9f7;
  border-radius: 16rpx;
  width: 100%;
  overflow: hidden;
}
.coach-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
}
.coach-card-title {
  font-size: 22rpx;
  color: #3b63d8;
  font-weight: 600;
}
.coach-card-arrow {
  font-size: 20rpx;
  color: #3b63d8;
}
.coach-card-body {
  padding: 0 20rpx 18rpx;
}

/* 评分进度条 */
.coach-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.coach-rating-label {
  font-size: 22rpx;
  color: #5a6aa0;
  flex-shrink: 0;
}
.coach-rating-bar {
  flex: 1;
  height: 14rpx;
  background: #d6dffa;
  border-radius: 999rpx;
  overflow: hidden;
}
.coach-rating-fill {
  height: 100%;
  background: linear-gradient(90deg, #6a8cff, #3b63d8);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.coach-rating-value {
  font-size: 22rpx;
  color: #3b63d8;
  font-weight: 600;
  flex-shrink: 0;
  min-width: 56rpx;
  text-align: right;
}

/* 点评文字 */
.coach-feedback-text {
  margin-bottom: 12rpx;
}
.coach-feedback-label {
  display: block;
  font-size: 22rpx;
  color: #5a6aa0;
  margin-bottom: 6rpx;
}
.coach-feedback-content {
  font-size: 24rpx;
  color: #2d3560;
  line-height: 1.55;
}

/* 改进建议列表 */
.coach-improvements-label {
  display: block;
  font-size: 22rpx;
  color: #5a6aa0;
  margin-bottom: 6rpx;
}
.coach-improvement-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 4rpx;
}
.coach-improvement-dot {
  color: #3b63d8;
  font-size: 24rpx;
  line-height: 1.55;
  flex-shrink: 0;
}
.coach-improvement-text {
  font-size: 24rpx;
  color: #2d3560;
  line-height: 1.55;
}
