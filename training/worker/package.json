{
  "name": "@training/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@training/contracts": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../api/.env dist/main.js",
    "dev": "node --env-file=../api/.env .dev-run.mjs",
    "test": "corepack pnpm run build && node --test test/*.test.mjs",
    "test:config": "tsc -p tsconfig.test.json && node --test test-dist/test/env-config.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  }
}
