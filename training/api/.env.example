# ─────────────────────────────────────────────────────────────────────────
# AI provider selection for the coaching API.
# Copy this file to modules/training/api/.env (git-ignored) and fill real values there.
# Defaults below keep the system fully offline (deterministic fakes), so a
# fresh checkout / CI / test run never needs network access or a secret.
# ─────────────────────────────────────────────────────────────────────────

# Model provider: "fake" (tests), "python" (prompt-driven customer simulation)
# or "http" (direct OpenAI-compatible gateway).
MODEL_PROVIDER=fake
# MODEL_PROVIDER=python
# MODEL_PROVIDER=http

# Required when MODEL_PROVIDER=python:
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
PYTHON_AI_TOKEN=dev-internal-ai-token-change-me
PYTHON_AI_TIMEOUT_MS=60000

# Required when MODEL_PROVIDER=http:
# OpenAI-compatible API root (no trailing "/chat/completions").
# Aliyun Bailian / DashScope example:
MODEL_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# Deployment / model id.
MODEL_NAME=qwen3.7-plus
# Secret API key — only ever read from the environment, never commit it.
MODEL_API_KEY=replace-with-your-key
# Per-request timeout in milliseconds (optional, default 30000).
MODEL_TIMEOUT_MS=30000

# Knowledge provider — one of:
#   "fake"     offline deterministic stub (default; no network, no secret)
#   "external" generic OpenAI-style external HTTP knowledge adapter
#   "weknora"  company-deployed WeKnora knowledge base. The deployed AI
#              solution uses POST /api/v1/knowledge-search and X-API-Key.
KNOWLEDGE_PROVIDER=fake
# KNOWLEDGE_PROVIDER=external
# KNOWLEDGE_PROVIDER=weknora

# ── Required when KNOWLEDGE_PROVIDER=external (generic HTTP adapter) ──
EXTERNAL_KNOWLEDGE_BASE_URL=http://weknora.internal/api
# Optional bearer token for the external knowledge service.
EXTERNAL_KNOWLEDGE_API_KEY=
# Optional timeout in milliseconds (default 10000).
EXTERNAL_KNOWLEDGE_TIMEOUT_MS=10000

# ── Required when KNOWLEDGE_PROVIDER=weknora (company deployment) ──
# Match the AI solution's names. On the shared server the beta deployment uses
# http://host.docker.internal:8081 from a container with host-gateway enabled.
WEKNORA_API_URL=http://weknora.internal:8081
WEKNORA_API_KEY=
# Comma-separated WeKnora knowledge-base UUIDs. When set, every approved
# release reference is searched in these bases; otherwise ref.itemId is used.
WEKNORA_KNOWLEDGE_BASE_IDS=
WEKNORA_SEARCH_TIMEOUT_MS=10000

# Backward-compatible aliases accepted by the provider reader:
# KNOWLEDGE_BASE_URL=http://weknora.internal:8081
# KNOWLEDGE_TOKEN=

# Local-only convenience for mini-program testing. Keep false in shared/production environments.
LOCAL_TEST_AUTH=false
# LOCAL_TEST_TOKEN=fixture:identity:valid
IDENTITY_PROVIDER=fake
GONGZHUGOU_INTROSPECTION_TIMEOUT_MS=5000
TRAINING_ORGANIZATION_ID=11111111-1111-1111-1111-111111111111
GONGZHUGOU_GATEWAY_MODE=false
TRAINING_ENABLED=false
